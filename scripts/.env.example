# ============================================================================
# Variables de entorno para los scripts de ingesta
# Copia este archivo a .env y llena los valores reales.
# ============================================================================

# ID del folder de Google Drive (el texto después de /folders/ en la URL)
# Ejemplo: https://drive.google.com/drive/u/0/folders/1Ouvvixd-eNSL_kPgEPRvfdC33ATHzdwl
#          → DRIVE_FOLDER_ID=1Ouvvixd-eNSL_kPgEPRvfdC33ATHzdwl
DRIVE_FOLDER_ID=

# Ruta al JSON de service account con permisos de lectura al Drive folder
# 1) Crear service account en https://console.cloud.google.com/iam-admin/serviceaccounts
# 2) Generar key JSON
# 3) Compartir el folder del Drive con el email del service account (Viewer)
GOOGLE_SERVICE_ACCOUNT_JSON=/Users/Bryan/montaña Dorada/scripts/google-sa.json

# Gemini API key — https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# OpenAI API key — https://platform.openai.com/api-keys (solo se usa para embeddings)
OPENAI_API_KEY=

# Supabase credentials — https://supabase.com/dashboard/project/_/settings/api
SUPABASE_URL=https://xxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Directorio temporal para cache local (opcional, default /tmp/montana-ingest)
TMP_DIR=/tmp/montana-ingest
