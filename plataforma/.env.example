# ─── API ─────────────────────────────────────────────────────────────────────
PORT=8080
NODE_ENV=development
# Secreto para firmar los JWT del panel admin (mínimo 32 caracteres en prod)
JWT_SECRET=cambia-esto-por-un-secreto-largo-y-aleatorio

# ─── Base de datos ───────────────────────────────────────────────────────────
# En desarrollo, si DATABASE_URL está vacío se usa PGlite embebido (carpeta ./.pglite)
# y no necesitas Docker. En EasyPanel pega aquí la URL del Postgres del proyecto.
# Ej: postgres://usuario:password@db:5432/asistencia
DATABASE_URL=

# ─── Correo (reportes y notificaciones) ──────────────────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Asistencia <no-reply@tudominio.com>
# Destinatarios por defecto de reportes (coma-separados). Se puede sobreescribir por negocio.
REPORT_EMAILS=

# ─── WhatsApp vía Evolution API (opcional) ───────────────────────────────────
EVOLUTION_URL=
EVOLUTION_KEY=
EVOLUTION_INSTANCE=

# ─── Web (frontend) ──────────────────────────────────────────────────────────
# URL pública de la API que consume el frontend.
VITE_API_URL=http://localhost:8080
