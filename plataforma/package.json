{
  "name": "asistencia-platform",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "pnpm -r --parallel dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "db:push": "pnpm --filter @asis/api db:push",
    "db:seed": "pnpm --filter @asis/api db:seed",
    "db:migrate-sheets": "pnpm --filter @asis/api migrate:sheets"
  }
}
